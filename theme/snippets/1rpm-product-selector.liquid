<style>
.rpm-selector > div {
	cursor: pointer;
}
</style>


<div class="rpm-selector">
  <div>
    <span style="font-weight: bold">
      *** Please note due to the cost, the price for this package will increase if you select premium items below.
    </span>
  </div>
  <div>
    <span style="font-weight: bold">Stress less. Cook more.<br>
      Select 5 different items by clicking below:</span>
    <div id="rpm-selector-selectable" class="rpm-selector"></div>
  </div>
  <div style="margin-top: 30px;">
    <span style="font-weight: bold">Selected:</span>
    <div id="rpm-selector-selected" class="rpm-selector"></div>
  </div>
</div>
<input type="hidden" name="properties[Selected]" id="rpm-selected-input"></input>
<input type="hidden" name="id" id="rpm-product-select-id"></input>

<script>
(function() {
  var possibleItems = [
    '4 Beef Burgers',
    '2 lbs Thin Sliced Antibiotic-Free Chicken',
    '2 lbs of Bell & Evans Chicken Legs and Thighs',
    '2 lbs of Stir Fry Chicken Strips',
    '2 lbs Antibiotic-Free Ground Turkey',
    '4 Boneless Pork Chops',
    '2 lbs Beef Cubes (for stews/kebobs)',
    '3.5 lb 8-Way Cut Up Chicken',
    '2 lbs Pork Shoulder',
    '2 lbs Meatball/Meatloaf Blend',
    '1 lbs Boneless Short Ribs (great for soups and stews)',
    '2 lbs Boneless Chicken Thighs',
    '2 lbs Whole Chicken Breast',
    '2 lbs Boneless Pork Roast',
    '4 Salmon Steaks 4 oz each (premium)'
  ];
  var productObj = {{product|json}};

  var selectedContainer = document.getElementById('rpm-selector-selected');
  var selectableContainer = document.getElementById('rpm-selector-selectable');
  var selectedInput = document.getElementById('rpm-selected-input');
  var productSelectId = document.getElementById('rpm-product-select-id');
  var priceElement = document.getElementById('ProductPrice-1rpm-product-selector-template');

  var resetSelectedItemText = function() {
    var children = selectedContainer.children;
    var selectedText = [];
    for (var i = 0; i < children.length; i++) {
      selectedText.push(children[i].getAttribute('data-item'));
    }
    var joinedText = selectedText.join(', ');
    selectedInput.value = joinedText;

    var variant = '' + (joinedText.match(/premium/g) || []).length;
    if (priceElement) {
      if (variant === '2') {
        priceElement.textContent = '$91.00';
      } else if (variant === '1') {
        priceElement.textContent = '$80.00';
      } else {
        priceElement.textContent = '$69.50';
      }
    }
    if (productObj && Array.isArray(productObj.variants)) {
      for (var j = 0; j < productObj.variants.length; j++) {
        if (productObj.variants[j].title == variant) {
          productSelectId.value = productObj.variants[j].id;
        }
      }
    }
  };

  var isItemSelected = function(item) {
    if (!selectedInput.value) {
      return false;
    }
    var selectedItems = selectedInput.value.split(', ');
    return selectedItems.indexOf(item) >= 0;
  };

  var addToSelectedItems = function(item) {
    if (selectedContainer.children.length >= 5) {
      return;
    }

    if (isItemSelected(item)) {
      alert("Oops! Looks like you've already selected this item");
      return;
    }

    var selectedItem = document.createElement('div');
    selectedItem.textContent = 'X ' + item;
    selectedItem.setAttribute('data-item', item);
    selectedItem.addEventListener('click', function() {
      if (selectedItem.parentNode) {
        selectedItem.parentNode.removeChild(selectedItem);
      }
      resetSelectedItemText();
    });
    selectedContainer.appendChild(selectedItem);

    resetSelectedItemText();
  };

  for (var idx = 0; idx < possibleItems.length; idx++) {
    (function(item) {
      var selectableItem = document.createElement('div');
      selectableItem.textContent = item;
      selectableItem.addEventListener('click', function() {
        addToSelectedItems(item);
      });
      selectableContainer.appendChild(selectableItem);
    })(possibleItems[idx]);
  }

  var addButton = document.querySelector('button[name="add"]');
  if (addButton) {
    addButton.addEventListener('click', function(e) {
      if (selectedContainer.children.length < 5) {
        alert('Please select five items.');
        e.preventDefault();
        return false;
      }
    });
  }
})();
</script>